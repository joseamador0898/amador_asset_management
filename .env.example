# Copy to .env.local for local development (never commit .env.local).
# On Vercel, add these under Project Settings > Environment Variables.

# Public site URL (used for canonical links, sitemap and OG images)
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Optional public contact email; when empty, pages route people to the contact form
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Amador Signals data providers (all server-side; never exposed to browsers)
# ---------------------------------------------------------------------------
# FRED (free key: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=
# Alpaca market data (free plan works; read-only data endpoints only)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# SEC EDGAR fair-access policy: identify yourself, e.g. "Amador Asset Management ops@yourdomain.com"
SEC_USER_AGENT=
# Cboe delayed option chains for the Options Pulse panels ("on" to enable).
# Confirm Cboe's terms permit your use before enabling on a public deployment.
SIGNALS_CBOE=
# Unusual Whales API (paid plan; enables Market Tide, Congress and Dark Pool panels)
UNUSUAL_WHALES_API_KEY=
# Gemini API key for the AI Morning Note (optional) and model override
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Forms: briefings, bookings, contact and fund interest
# ---------------------------------------------------------------------------
# Resend (https://resend.com): email the team and send confirmations
RESEND_API_KEY=
EMAIL_FROM=Amador Asset Management <hello@yourdomain.com>
EMAIL_TO=you@yourdomain.com
# Optional Resend audience for briefing subscribers
RESEND_AUDIENCE_ID=
# Optional webhook (Zapier, Make, Slack, Google Apps Script, CRM) that receives every submission as JSON
FORMS_WEBHOOK_URL=

# Optional: show a live Cal.com calendar on /book instead of the request form, e.g. "amador/discovery"
NEXT_PUBLIC_CALCOM_LINK=

# Optional: Google AdSense publisher ID ("ca-pub-..."). Adds the verification meta tag, script and /ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT=
