# /etc/caddy/amador.caddy, imported at the end of the VM's /etc/caddy/Caddyfile.
# amadoram.com -> Next.js on 127.0.0.1:8781 (amador-web.service). Certificates are automatic.

# ads.txt answers 200 directly on http:// and www (no redirect hops for the AdSense crawler).
(amador_adstxt) {
	@amador_adstxt path /ads.txt
	handle @amador_adstxt {
		reverse_proxy 127.0.0.1:8781 {
			header_up Host amadoram.com
		}
	}
}

http://amadoram.com, http://www.amadoram.com {
	import amador_adstxt
	handle {
		redir https://amadoram.com{uri} permanent
	}
}

www.amadoram.com {
	import amador_adstxt
	handle {
		redir https://amadoram.com{uri} permanent
	}
}

amadoram.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	request_body {
		max_size 2MB
	}
	reverse_proxy 127.0.0.1:8781 {
		transport http {
			dial_timeout 5s
			response_header_timeout 60s
		}
	}
	log {
		output file /var/log/caddy/amador.log {
			roll_size 20MiB
			roll_keep 5
			roll_keep_for 336h
		}
		format filter {
			wrap json
			fields {
				request>uri regexp "\?.*$" ""
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>remote_ip ip_mask 24 48
				request>client_ip ip_mask 24 48
			}
		}
	}
}
